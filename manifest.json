{
  "manifest_version": 3,
  "name": "Grok Video Automator",
  "version": "1.0.0",
  "description": "Automates batch video generation in Grok AI by sequentially pairing images with prompts.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://grok.x.ai/*",
    "https://x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.x.ai/*",
        "https://x.com/grok*",
        "https://x.com/i/grok*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
